#!/bin/sh /etc/rc.common
# Copyright (C) 2020 OpenWrt.org

START=99
BIN=/usr/sbin/owntone
PID=/var/run/owntone.pid
WATCHDOG_PID=/var/run/owntone_watchdog.pid
SSD=start-stop-daemon

NAME=owntone

uci_get_by_name() {
	local ret=$(uci get $NAME.$1.$2 2>/dev/null)
	echo ${ret:=$3}
}

uci_get_by_type() {
	local ret=$(uci get $NAME.@$1[0].$2 2>/dev/null)
	echo ${ret:=$3}
}

gen_config_file() {

	# 生成最精简的音频配置，让 OwnTone 使用默认软件音量
	cat <<-EOF >/var/etc/owntone.conf
general {
	uid = "root"
	db_path = "$(uci_get_by_type owntone db_path)"
	logfile = "/var/log/owntone.log"
	loglevel = log
	ipv6 = yes
	cache_path = "/var/owntone-cache.db"
}

library {
    name = "$(uci_get_by_type owntone player_name 'My Music on OpenWrt')"
    port = $(uci_get_by_type owntone port 3689)
    directories = { "$(uci_get_by_type owntone directories)" }
    podcasts = { "/Podcasts" }
    audiobooks = { "/Audiobooks" }
    compilations = { "/Compilations" }
    compilation_artist = "Various Artists"
}

mpd {
    port = $(uci_get_by_type owntone mpd_port '6600')
}

audio {
    nickname = "Local Audio Output"
    type = "alsa"
    card = "softvol"
    mixer = "Softvol"
    mixer_device = "hw:0"
}
EOF
}

# ============================================================
# 自动播放整个音乐库
# ============================================================
autoplay_library() {
    # 加锁，防止并发执行
    local LOCK_FILE=/var/run/owntone_autoplay.lock
    if [ -f "$LOCK_FILE" ]; then
        local old_pid=$(cat "$LOCK_FILE" 2>/dev/null)
        if [ -n "$old_pid" ] && kill -0 "$old_pid" 2>/dev/null; then
            logger -t owntone "autoplay: 已在运行中 (PID: $old_pid)，跳过本次触发"
            return 1
        fi
    fi
    echo $$ > "$LOCK_FILE"
    
    # 脚本退出时删除锁文件
    trap 'rm -f "$LOCK_FILE"' EXIT

    local port=$(uci_get_by_type owntone port 3689)
    local do_shuffle=$(uci_get_by_type owntone autoplay_random 0)
    local do_repeat=$(uci_get_by_type owntone autoplay_repeat 0)
    local url="http://127.0.0.1:${port}/api"
    local i=0

    command -v curl >/dev/null 2>&1 || {
        logger -t owntone "autoplay: curl not found, skip"
        return 1
    }

    # 阶段1：等 HTTP API 就绪（最多 60 秒）
    while [ $i -lt 60 ]; do
        curl -s -o /dev/null "${url}/player" && break
        sleep 1
        i=$((i + 1))
    done

    if [ $i -ge 60 ]; then
        logger -t owntone "autoplay: API not ready after 60s, skip"
        return 1
    fi

     # 阶段2：等音乐库扫描完成（最多再等 120 秒）
    sleep 15

    local j=0
    while [ $j -lt 120 ]; do
        # 改用 /api/library，检查是否返回了歌曲数量（正常时字段为 "songs"）
        local library_json=$(curl -s --connect-timeout 2 "${url}/library" 2>/dev/null)
        local songs_n=$(echo "$library_json" | sed -n 's/.*"songs": *\([0-9][0-9]*\).*/\1/p')
        if echo "$library_json" | grep -q '"updating": false' && [ -n "$songs_n" ] && [ "$songs_n" -gt 0 ]; then
            sleep 6
            local library_json2=$(curl -s --connect-timeout 2 "${url}/library" 2>/dev/null)
            if echo "$library_json2" | grep -q '"updating": false'; then
                break
            fi
        fi
        sleep 2
        j=$((j + 2))
    done

    if [ $j -ge 120 ]; then
        logger -t owntone "autoplay: library scan not ready after 120s, skip"
        return 1
    fi

        # 阶段3：稍微等一下数据库写入空闲（延长到 10 秒，等 vacuum 彻底结束）
    sleep 10

    # 1. 先清空队列（减轻单次请求压力）
    local k=0
    while [ $k -lt 4 ]; do
        curl -s -X PUT "${url}/queue/clear" >/dev/null 2>&1
        sleep 2
        local q0=$(curl -s --connect-timeout 2 "${url}/queue" 2>/dev/null | sed -n 's/.*"count": *\([0-9][0-9]*\).*/\1/p')
        [ "$q0" = "0" ] && break
        k=$((k + 1))
    done

    # 2. 再加入音乐库（注意 clear 改为 false，不要求立刻播放）
    curl -s -X POST \
        "${url}/queue/items/add?expression=media_kind+is+music&clear=false" \
        >/dev/null 2>&1
    sleep 3

    local sn=$(curl -s --connect-timeout 2 "${url}/library" 2>/dev/null | sed -n 's/.*"songs": *\([0-9][0-9]*\).*/\1/p')
    local qn=$(curl -s --connect-timeout 2 "${url}/queue" 2>/dev/null | sed -n 's/.*"count": *\([0-9][0-9]*\).*/\1/p')
    if [ -n "$sn" ] && [ -n "$qn" ] && [ "$qn" -gt "$sn" ]; then
        logger -t owntone "autoplay: queue $qn > songs $sn, resetting queue"
        curl -s -X PUT "${url}/queue/clear" >/dev/null 2>&1
        sleep 2
        curl -s -X POST "${url}/queue/items/add?expression=media_kind+is+music&clear=false" >/dev/null 2>&1
        sleep 2
    fi

    # 入队后确认队列真的有歌（扫描/锁库时 add 可能失败，这里自动重试）
    local try=0
    while [ $try -lt 4 ]; do
        local qn2=$(curl -s --connect-timeout 2 "${url}/queue" 2>/dev/null | sed -n 's/.*"count": *\([0-9][0-9]*\).*/\1/p')
        if [ -n "$qn2" ] && [ "$qn2" -gt 0 ]; then
            break
        fi
        sleep 12
        curl -s -X PUT "${url}/queue/clear" >/dev/null 2>&1
        sleep 2
        curl -s -X POST "${url}/queue/items/add?expression=media_kind+is+music&clear=false" >/dev/null 2>&1
        sleep 3
        try=$((try + 1))
    done

    if [ "$do_shuffle" = "1" ]; then
        curl -s -X PUT "${url}/player/shuffle?state=true"  >/dev/null 2>&1
    else
        curl -s -X PUT "${url}/player/shuffle?state=false" >/dev/null 2>&1
    fi

    if [ "$do_repeat" = "1" ]; then
        curl -s -X PUT "${url}/player/repeat?state=all"  >/dev/null 2>&1
    else
        curl -s -X PUT "${url}/player/repeat?state=off" >/dev/null 2>&1
    fi

    curl -s -X PUT "${url}/player/play" >/dev/null 2>&1
    logger -t owntone "autoplay: library playback started (shuffle=${do_shuffle}, repeat=${do_repeat})"
}

# ============================================================
# 看门狗：定时检测进程，崩溃后自动重启
# ============================================================
owntone_watchdog() {
	while true; do
		sleep 10
		# 检查 PID 文件是否存在且进程是否存活
		if [ ! -f $PID ] || ! kill -0 $(cat $PID) 2>/dev/null; then
			# 仅当 UCI 中服务为启用状态时才重启
			local enabled=$(uci_get_by_type owntone enabled 0)
			if [ "$enabled" = "1" ]; then
				logger -t owntone "watchdog: 检测到进程崩溃，正在自动重启..."
				ensure_softvol
				$SSD -p $PID -S -b -x $BIN -- -P $PID -c /var/etc/owntone.conf
				
		# 如果开启了自动播放，崩溃重启后延迟触发，避免数据库死锁
				local autoplay=$(uci_get_by_type owntone autoplay 0)
				if [ "$autoplay" = "1" ]; then
					( sleep 15; autoplay_library ) &
				fi			fi
		fi
	done
}

# 启动前确保 SOFTVOL 控件存在；不存在就按当前声卡重建 /etc/asound.conf
ensure_softvol() {
	local conf=/etc/asound.conf
	local card num
	card=$(sed -n 's/.*pcm "hw:\([^",]*\),.*/\1/p' "$conf" 2>/dev/null | head -n 1)

	if [ -z "$card" ]; then
		set -- $(sed -n 's/^ *\([0-9][0-9]*\) \[\([^ ]*\).*/\1 \2/p' /proc/asound/cards 2>/dev/null | head -n 1)
		num=$1
		card=$2
	fi

	if [ -z "$card" ]; then
		logger -t owntone "softvol: 未检测到声卡，跳过检查"
		return 1
	fi

	case "$card" in
		*[!0-9]*) num=$(sed -n "s/^ *\([0-9][0-9]*\) \[$card .*/\1/p" /proc/asound/cards 2>/dev/null | head -n 1) ;;
		*) num=$card ;;
	esac
	[ -z "$num" ] && num=0

	if amixer -c "$num" scontrols 2>/dev/null | grep -q "'Softvol'"; then
		return 0
	fi

	if [ ! -f "$conf" ] || ! grep -q 'pcm.softvol' "$conf" || ! grep -q 'name "Softvol"' "$conf"; then
		[ -f "$conf" ] && cp -f "$conf" "$conf.bak-$(date +%Y%m%d-%H%M%S)"
		cat > "$conf" <<EOF
defaults.pcm.dmix.rate 44100
defaults.pcm.dmix.format S16_LE

pcm.!default {
    type plug
    slave.pcm "dmixer"
}

pcm.dmixer {
    type dmix
    ipc_key 1024
    ipc_perm 0666
    slave {
        pcm "hw:$card,0"
        period_time 0
        period_size 1024
        buffer_size 8192
        rate 44100
        format S16_LE
    }
    bindings { 0 0 1 1 }
}
ctl.dmixer {
    type hw
    card $card
}

pcm.softvol {
    type softvol
    slave.pcm "plug:dmixer"
    control {
        name "Softvol"
        card $card
    }
}
EOF
		chmod 644 "$conf"
		logger -t owntone "softvol: 已按声卡 $card 重建 /etc/asound.conf"
	fi

	aplay -D softvol /dev/zero -d 1 >/dev/null 2>&1
	sleep 1

	if amixer -c "$num" scontrols 2>/dev/null | grep -q "'Softvol'"; then
		logger -t owntone "softvol: 控件就绪 (card=$num)"
		return 0
	fi
	logger -t owntone "softvol: 重建后仍未找到 Softvol 控件"
	return 1
}

start() {
    # 首次启动延迟（仅系统开机时生效，手动重启不延迟）
    local DELAY_FLAG=/tmp/.owntone_boot_done
    if [ ! -f "$DELAY_FLAG" ]; then
        local delay=$(uci_get_by_type owntone delay_start 10)
        [ "$delay" -gt 0 ] 2>/dev/null && {
            logger -t owntone "首次启动，延迟 ${delay} 秒等待系统就绪..."
            sleep "$delay"
        }
        touch "$DELAY_FLAG"
    fi

	gen_config_file
	mkdir -p /var/cache/owntone

	local enabled=$(uci_get_by_type owntone enabled 0)
	[ "$enabled" = "0" ] && return 1

	# 先清理可能残留的看门狗进程
	[ -f $WATCHDOG_PID ] && kill $(cat $WATCHDOG_PID) 2>/dev/null
	rm -f $WATCHDOG_PID

    # 提前激活softvol软声卡防止播放器启动前找不到
    ensure_softvol
    sleep 1

	# 启动 owntone 主进程
	$SSD -p $PID -S -b -x $BIN -- -P $PID -c /var/etc/owntone.conf

	# 启动看门狗（后台运行，并保存其 PID）
	owntone_watchdog >/dev/null 2>&1 &
	echo $! > $WATCHDOG_PID

	# ---- 自动播放开关 ----
	local autoplay=$(uci_get_by_type owntone autoplay 0)
	if [ "$autoplay" = "1" ]; then
		# 后台执行，不阻塞服务启动
		autoplay_library &
	fi
}

stop() {
	# 先停止看门狗，防止它反复拉起 owntone
	if [ -f $WATCHDOG_PID ]; then
		kill $(cat $WATCHDOG_PID) 2>/dev/null
		rm -f $WATCHDOG_PID
	fi
	$SSD -p $PID -K -s SIGINT >/dev/null
}

restart() {
	stop
	local i=0
	while [ -f $PID ] && [ $i -lt 10 ]; do
		sleep 1
		i=$((i + 1))
	done
	start
}
